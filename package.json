{
  "name": "gearpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:check": "node scripts/validate-catalog.mjs --catalog src/data/candidates.json --dry-run && node --experimental-strip-types scripts/observations.ts validate --input src/data/observations.json",
    "observations:list": "node --experimental-strip-types scripts/observations.ts list",
    "observations:validate": "node --experimental-strip-types scripts/observations.ts validate",
    "observations:preview": "node --experimental-strip-types scripts/observations.ts preview",
    "observations:ingest": "node --experimental-strip-types scripts/observations.ts ingest",
    "observations:review": "node --experimental-strip-types scripts/observations.ts review",
    "observations:record": "node --experimental-strip-types scripts/observations.ts record",
    "quality:report": "node --experimental-strip-types scripts/observations.ts report",
    "audit:config": "node scripts/audit-configuration-identity.mjs"
  },
  "dependencies": {
    "astro": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "playwright": "^1.56.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
