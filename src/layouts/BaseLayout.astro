---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { createBreadcrumbStructuredData, PUBLIC_SITE_URL, serializeJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  indexable?: boolean;
  breadcrumbs?: { label: string; path: string }[];
}
const { title, description, canonicalPath = Astro.url.pathname, indexable = true, breadcrumbs = [] } = Astro.props;
const site = Astro.site ?? new URL(PUBLIC_SITE_URL);
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site).href,
  name: 'GearPilot AI',
  url: new URL('/', site).href,
  inLanguage: 'en-US',
};
const breadcrumbStructuredData = breadcrumbs.length ? createBreadcrumbStructuredData(breadcrumbs) : null;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} canonicalPath={canonicalPath} indexable={indexable} />
    <script type="application/ld+json" set:html={serializeJsonLd(websiteStructuredData)}></script>
    {breadcrumbStructuredData && <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbStructuredData)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
      <nav aria-label="Primary navigation">
        <a class="brand" href="/">GearPilot AI</a>
        <a href="/guides/standing-desk-fit/">Desk setup guide</a>
        <a href="/methodology/">Methodology</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
      </nav>
    </header>
    <main id="main-content">
      {breadcrumbs.length > 0 && <nav aria-label="Breadcrumb"><ol class="breadcrumbs">{breadcrumbs.map((item) => <li><a href={item.path}>{item.label}</a></li>)}</ol></nav>}
      <slot />
    </main>
    <footer>
      <p>GearPilot AI provides transparent comparison tooling, not hands-on product reviews.</p>
      <nav aria-label="Footer navigation"><a href="/guides/standing-desk-fit/">Desk setup guide</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/methodology/">Methodology</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a></nav>
    </footer>
  </body>
</html>
