---
import '../styles/global.css';

interface Props { title: string; description: string; canonicalPath?: string; }
const { title, description, canonicalPath = '/' } = Astro.props;
const site = Astro.site ?? new URL('https://gearpilot-ai.hithisisakii09.workers.dev');
const canonicalUrl = new URL(canonicalPath, site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: 'GearPilot AI', url: site.href },
    { '@type': 'WebSite', name: 'GearPilot AI', url: site.href, inLanguage: 'en-US' },
  ],
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GearPilot AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
      <nav aria-label="Primary navigation">
        <a class="brand" href="/">GearPilot AI</a>
        <a href="/methodology/">Methodology</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      <p>GearPilot AI provides transparent comparison tooling, not hands-on product reviews.</p>
      <nav aria-label="Footer navigation"><a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/methodology/">Methodology</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a></nav>
    </footer>
  </body>
</html>
