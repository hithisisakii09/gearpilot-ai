---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_CONTACT_EMAIL, PUBLIC_CONTACT_MAILTO } from '../lib/contact';
---
<BaseLayout title="Contact | GearPilot AI" description="Contact GearPilot AI by email for questions, privacy requests, corrections, or affiliate inquiries." canonicalPath="/contact/" indexable={false}>
  <h1>Contact</h1>
  <p>For general questions, privacy requests, corrections, or affiliate inquiries, email <a href={PUBLIC_CONTACT_MAILTO}>{PUBLIC_CONTACT_EMAIL}</a>.</p>
  <p>The owner reports testing this address for sending and receiving. This page is not a contact form and does not automatically collect visitor information.</p>
  <p>This site is currently a demonstration. Do not send sensitive, financial, tax, or identity documents by email.</p>
</BaseLayout>
